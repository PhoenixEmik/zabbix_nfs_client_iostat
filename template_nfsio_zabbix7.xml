            <template>Template NFS IO Stats</template>
            <name>Template NFS IO Stats</name>
            <description>NFS client statistics from nfsiostat. Modern templates collect all metrics once per mount and use dependent items.</description>
            <groups>
                <group>
                    <name>Templates</name>
                </group>
            </groups>
            <discovery_rules>
