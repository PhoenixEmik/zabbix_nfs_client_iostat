                            <delay>1m</delay>
                            <history>0</history>
                            <trends>0</trends>
                            <value_type>TEXT</value_type>
                            <description>Raw JSON returned by one nfsiostat sample. Used by dependent item prototypes.</description>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>NFS raw</value>
                                </tag>
                            </tags>
                        </item_prototype>
