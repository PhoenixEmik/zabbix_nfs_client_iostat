                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <description>Average length of the RPC backlog queue.</description>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.bklog</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
